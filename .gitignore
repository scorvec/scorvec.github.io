# private research — kept local only (2026-07-28)
stratosphere.html
assets/strat/
scripts/telecon/
scripts/verify/data/
# scripts/strat is excluded by CONTENTS (trailing /*), not as a directory: git
# cannot re-include a file whose parent directory is excluded, so the three
# negations below would silently do nothing under `scripts/strat/`.
# Published 2026-08-29: only the scripts behind the LIVE figures on
# enso-atmosphere.html (nh_vortex.webp, wave1_amp.webp, the E-P flux loop).
# Everything else here still writes to assets/strat/, which stays private and
# only feeds the local stratosphere.html.
scripts/strat/*
!scripts/strat/nh_vortex.py
!scripts/strat/qbo_duct.py
!scripts/strat/vortex_winds.py
!scripts/strat/wave1_maps.py
!scripts/strat/build_m2_reference.py
!scripts/strat/build_wave1_clim.py
# The MERRA-2 reference cache (282 KB) that replaces the 690 MB laptop-only
# archive for nh_vortex on a runner. The directory itself must be re-included
# first - git will not descend into an excluded directory to find the file.
!scripts/strat/reference/
!scripts/strat/reference/m2_strat_daily.nc
!scripts/strat/reference/strat_obs_daily.nc

# removed-project local archive (ERCOT page + C3S winter analysis, restorable)
local_archive/
scripts/mjo/data/reference/arco_eq_u/
scripts/mjo/data/reference/m2_eq_u/
scripts/sfs/data/*.npy
scripts/sst/.run.lock/
scripts/sst/data/region_weights_energy.npz
scripts/verify/launchd_aifs.log

# local stamp for scripts/lib/publish_frames.sh
scripts/lib/.frames_published
scripts/lib/.frames.lock
scripts/lib/frames.log

# ── animation frames ────────────────────────────────────────────────────────
# Frame webp are served from the orphan `frames` branch, not from main — the
# daily churn was ~6 GB/month of permanent history and forced a full history
# collapse on 2026-08-28. Published by scripts/lib/publish_frames.sh (launchd
# com.scorvec.frames, every 15 min). The *_manifest.json files stay tracked, so
# the viewers still fetch them same-origin.
assets/*/anim/**/*.webp
# EXCEPT the dirs built only by GitHub workflows. The frames branch has a
# SINGLE publisher (the laptop) because several producers force-pushing one
# orphan branch would clobber each other — so these must stay on main for the
# laptop to pull and republish. They are ~10% of the churn.
!assets/sst/anim/gdps_ir/*.webp
!assets/sst/anim/gdps_wind/*.webp
!assets/sst/anim/gdps_outflow/*.webp
!assets/sst/anim/mur_ct/*.webp
!assets/sst/anim/pacsat/*.webp
!assets/sst/anim/samsat/*.webp

# asos5 local runner log
scripts/asos5/asos5.log

# columbia pipeline weights cache
.cache/

# oil board: PDFs are built on the laptop at send time (scripts/oil/oil_mail_local.py); keep them out of the repo
data/oil/report/
