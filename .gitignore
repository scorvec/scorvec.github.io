scripts/telecon/data/ibtracs_wp.csv
scripts/telecon/data/gwd_daily/
scripts/telecon/data/merra2_gwd_events/
scripts/telecon/data/outcomes/
scripts/strat/data/

# private research — kept local only (2026-07-28). stratosphere.html was un-ignored 2026-09-26: the name now
# belongs to the public page split out of circulation.html (public products only); the research stays in assets/strat/.
assets/strat/
scripts/telecon/
scripts/verify/data/
# scripts/strat is excluded by CONTENTS (trailing /*), not as a directory: git
# cannot re-include a file whose parent directory is excluded, so the three
# negations below would silently do nothing under `scripts/strat/`.
# Published 2026-08-29: only the scripts behind the LIVE figures on
# enso-atmosphere.html (nh_vortex.webp, wave1_amp.webp, the E-P flux loop).
# Everything else here still writes to assets/strat/, which stays private and
# only feeds the local stratosphere.html.
scripts/strat/*
!scripts/strat/nh_vortex.py
!scripts/strat/qbo_duct.py
!scripts/strat/vortex_winds.py
!scripts/strat/wave1_maps.py
!scripts/strat/build_m2_reference.py
!scripts/strat/build_wave1_clim.py
!scripts/strat/heatflux100.py
!scripts/strat/heatflux100_ext.py
!scripts/strat/bdc_dc.py
!scripts/strat/geos_pv.py
!scripts/strat/momentum_budget.py
!scripts/strat/build_vt100_clim.py
!scripts/strat/build_strat_history.py
!scripts/strat/strat_history.py
!scripts/strat/build_cmip6_drip.py
!scripts/strat/build_cmip6_follow.py
!scripts/strat/cmip6_follow_extract.py
!scripts/strat/forecast_drip.py
!scripts/strat/geosfp_cap.py
!scripts/strat/build_drip_ref.py
!scripts/strat/upperstrat.py
!scripts/strat/upperstrat_data.py
!scripts/strat/build_upperstrat_clim.py
!scripts/strat/build_ssw_precursors.py
!scripts/strat/ssw_precursors.py
!scripts/strat/build_mbudget_history.py
!scripts/strat/fetch_m2gmi_aoa.py
!scripts/strat/build_age_of_air.py
!scripts/strat/age_of_air.py
!scripts/strat/fetch_mls_h2o.py
!scripts/strat/tape_recorder.py
!scripts/strat/ifs_ens.py
# The MERRA-2 reference cache (282 KB) that replaces the 690 MB laptop-only
# archive for nh_vortex on a runner. The directory itself must be re-included
# first - git will not descend into an excluded directory to find the file.
!scripts/strat/reference/
!scripts/strat/reference/m2_strat_daily.nc
!scripts/strat/reference/vt100_clim.nc
!scripts/strat/reference/heatflux100_history_seed.json
!scripts/strat/reference/strat_obs_daily.nc
!scripts/strat/reference/strat_history.nc
!scripts/strat/reference/strat_history_events.json
!scripts/strat/reference/cmip6_drip.nc
!scripts/strat/reference/cmip6_follow.nc
!scripts/strat/reference/drip_std.json
!scripts/strat/reference/mbudget_clim.npz
!scripts/strat/reference/geosfp_cap_offset.json
!scripts/strat/reference/geosfp_cap_seed.json
!scripts/strat/reference/aifs_capdrift.json
!scripts/strat/reference/ssw_precursors.json
!scripts/strat/reference/mbudget_history.json
!scripts/strat/reference/age_of_air.nc
!scripts/strat/reference/tape_mls.npz
!scripts/strat/reference/tape_geosfp_seed.npz

# removed-project local archive (ERCOT page + C3S winter analysis, restorable)
local_archive/
scripts/mjo/data/reference/arco_eq_u/
scripts/mjo/data/reference/m2_eq_u/
scripts/sfs/data/*.npy
