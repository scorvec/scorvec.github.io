<?xml version="1.0" encoding="UTF-8"?>
<!-- LaunchAgent: GEML vs GDPS loop suite, twice daily (per model cycle).
     02:30 local -> 00Z cycle (complete on Datamart well before), 14:30 local
     -> 12Z cycle. Install:
       cp scripts/geml/com.scorvec.geml.plist ~/Library/LaunchAgents/
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.scorvec.geml.plist
     Reload after edits:
       launchctl bootout gui/$(id -u)/com.scorvec.geml 2>/dev/null
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.scorvec.geml.plist -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.scorvec.geml</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/shawn/scorvec.github.io/scripts/geml/run_geml.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>2</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Hour</key><integer>14</integer><key>Minute</key><integer>30</integer></dict>
  </array>
  <key>StandardOutPath</key><string>/Users/shawn/scorvec.github.io/scripts/geml/launchd.log</string>
  <key>StandardErrorPath</key><string>/Users/shawn/scorvec.github.io/scripts/geml/launchd.log</string>
  <key>RunAtLoad</key><false/>
  <key>ProcessType</key><string>Background</string>
  <key>LowPriorityIO</key><true/>
</dict>
</plist>
