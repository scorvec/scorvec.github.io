<?xml version="1.0" encoding="UTF-8"?>
<!-- LaunchAgent: local SST/RONI builder (primary). Install with:
       cp scripts/sst/com.scorvec.sst.plist ~/Library/LaunchAgents/
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.scorvec.sst.plist
     Reload after edits:
       launchctl bootout gui/$(id -u)/com.scorvec.sst 2>/dev/null
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.scorvec.sst.plist
     Run once now (test):
       launchctl kickstart -k gui/$(id -u)/com.scorvec.sst
     Runs at 08:35 & 13:35 local (ET) — soon after the day's OISST lands (~12 UTC);
     the second attempt and the GitHub Action fallback (14:23 UTC) no-op if the
     OISST day is already committed (commit-if-changed). -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.scorvec.sst</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/shawn/scorvec.github.io/scripts/sst/run_local_sst.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>35</integer></dict>
    <dict><key>Hour</key><integer>13</integer><key>Minute</key><integer>35</integer></dict>
  </array>
  <key>StandardOutPath</key><string>/Users/shawn/scorvec.github.io/scripts/sst/launchd.out.log</string>
  <key>StandardErrorPath</key><string>/Users/shawn/scorvec.github.io/scripts/sst/launchd.err.log</string>
  <key>RunAtLoad</key><false/>
  <key>ProcessType</key><string>Background</string>
</dict>
</plist>
