<?xml version="1.0" encoding="UTF-8"?>
<!-- LaunchAgent: 12Z AIFS single-vs-ENS-control animator, daily 14:00 ET
     (1 PM CT — the 12Z open-data cycle is complete by then). Install:
       cp scripts/verify/com.scorvec.aifsanim.plist ~/Library/LaunchAgents/
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.scorvec.aifsanim.plist
     Reload after edits:
       launchctl bootout gui/$(id -u)/com.scorvec.aifsanim 2>/dev/null
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.scorvec.aifsanim.plist -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.scorvec.aifsanim</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/shawn/scorvec.github.io/scripts/verify/run_aifs_12z.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>14</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>/Users/shawn/scorvec.github.io/scripts/verify/launchd_aifs.log</string>
  <key>StandardErrorPath</key><string>/Users/shawn/scorvec.github.io/scripts/verify/launchd_aifs.log</string>
  <key>RunAtLoad</key><false/>
  <key>ProcessType</key><string>Background</string>
  <key>LowPriorityIO</key><true/>
</dict>
</plist>
