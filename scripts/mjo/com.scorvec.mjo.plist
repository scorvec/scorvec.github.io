<?xml version="1.0" encoding="UTF-8"?>
<!-- LaunchAgent: local MJO builder (primary). Install with:
       cp scripts/mjo/com.scorvec.mjo.plist ~/Library/LaunchAgents/
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.scorvec.mjo.plist
     Reload after edits:
       launchctl bootout gui/$(id -u)/com.scorvec.mjo 2>/dev/null
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.scorvec.mjo.plist
     Run once now (test):
       launchctl kickstart -k gui/$(id -u)/com.scorvec.mjo
     Runs at 02:45 (00Z cycle) & 14:45 (12Z) local — soon after each cycle's data
     lands; misses while asleep coalesce to one run on wake (the Action fallback
     covers those, polling 08:37/11:37Z and 20:37/23:37Z). -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.scorvec.mjo</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/shawn/scorvec.github.io/scripts/mjo/run_local.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>2</integer><key>Minute</key><integer>45</integer></dict>
    <dict><key>Hour</key><integer>14</integer><key>Minute</key><integer>45</integer></dict>
  </array>
  <key>StandardOutPath</key><string>/Users/shawn/scorvec.github.io/scripts/mjo/launchd.out.log</string>
  <key>StandardErrorPath</key><string>/Users/shawn/scorvec.github.io/scripts/mjo/launchd.err.log</string>
  <key>RunAtLoad</key><false/>
  <key>ProcessType</key><string>Background</string>
</dict>
</plist>
