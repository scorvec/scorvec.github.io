#!/bin/bash
# Laptop guard: this machine must not push rendered site products.
#
# Every image/animation product on the site is rendered by GitHub Actions. The
# laptop only dispatches workflows (scripts/lib/dispatch_workflows.sh) and
# publishes the GEPS frames. On 2026-09-04 a local 15-minute job
# (run_subsurface_light.sh, via com.scorvec.sst) re-rendered the TAO
# cross-section and pushed it over the CI's, so the subsurface page showed a
# day-old frame under a current manifest. Those jobs are unloaded; this hook is
# the backstop that stops the next one before it reaches GitHub.
#
# Allowed under assets/: geps/** (the one local publisher the user kept),
# pjm/** (desk-pull data, not a rendered job), the SEAS5 outlook outputs
# (assets/sst/seas5_*.webp + assets/sst/data/seas5_outlook.json — the CDS
# credentials stay on this laptop by the user's decision of 2026-09-06, so
# scripts/sst/run_seas5.sh renders and publishes them here), and .js/.css.
# Override for a deliberate one-off:  ALLOW_LOCAL_ASSET_PUSH=1 git push
[ "${ALLOW_LOCAL_ASSET_PUSH:-0}" = "1" ] && exit 0
z=0000000000000000000000000000000000000000
bad=""
while read -r lref lsha rref rsha; do
  [ "$lsha" = "$z" ] && continue                       # branch deletion
  if [ "$rsha" = "$z" ]; then files=$(git ls-tree -r --name-only "$lsha");
  else files=$(git diff --name-only --diff-filter=d "$rsha" "$lsha"); fi   # deletions are not renders
  hit=$(printf '%s\n' "$files" | grep -E '^assets/' \
        | grep -vE '^assets/(geps|pjm)/' | grep -vE '\.(js|css)$' \
        | grep -vE '^assets/sst/(seas5_[a-z0-9_]+\.webp|data/seas5_outlook\.json)$' || true)
  [ -n "$hit" ] && bad="$bad$hit"$'\n'
done
if [ -n "$bad" ]; then
  echo "pre-push BLOCKED: this laptop must not push rendered site assets." >&2
  echo "Rendering belongs to GitHub Actions; the laptop only dispatches." >&2
  echo "Offending paths:" >&2
  printf '%s' "$bad" | sort -u | head -20 >&2
  echo "If this is deliberate: ALLOW_LOCAL_ASSET_PUSH=1 git push" >&2
  exit 1
fi
exit 0
